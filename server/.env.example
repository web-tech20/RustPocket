# Adresse d'écoute du serveur.
RUSTPOCKET_BIND=0.0.0.0:8080

# Base SQLite des comptes.
RUSTPOCKET_DATABASE=rustpocket.db

# Secret de signature des jetons JWT. À changer absolument en production.
RUSTPOCKET_JWT_SECRET=change-me-with-a-long-random-string
RUSTPOCKET_TOKEN_TTL=2592000

# Mode d'exécution : local (développement) ou docker (production).
RUSTPOCKET_SANDBOX=local
RUSTPOCKET_SANDBOX_IMAGE=rustpocket-sandbox:latest

# Limites d'exécution.
RUSTPOCKET_MAX_CODE_BYTES=65536
RUSTPOCKET_MAX_OUTPUT_BYTES=65536
RUSTPOCKET_COMPILE_TIMEOUT=30
RUSTPOCKET_RUN_TIMEOUT=10
RUSTPOCKET_FORMAT_TIMEOUT=10

# Quotas par utilisateur.
RUSTPOCKET_RUNS_PER_MINUTE=20
RUSTPOCKET_RUNS_PER_DAY=300
